# WordPress Headless CMS – Configuración
# Copia este archivo como .env y rellena los valores

# URL base de tu WordPress (sin slash final)
WORDPRESS_API_URL=https://tu-wordpress.com

# Opcional: si usas WPGraphQL
# WORDPRESS_GRAPHQL_URL=https://tu-wordpress.com/graphql

# El idioma por defecto del sitio (en o es)
PUBLIC_DEFAULT_LANG=en
