---
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";
import Thanks from "@components/infopages/ThankYou.astro";
import GrainyGradient from "@components/global/GrainyGradient.astro";

const seo: AstroSeoProps = {
	title: "Thank You - Majestico Studio: Email Successfully Sent",
	description:
		"Thank you for reaching out to Majestico Studio! Your email has been successfully sent. We appreciate your interest and will respond promptly.",
	canonical: "https://mintaka.co/thank-you/",
};
---

<BaseLayout seo={seo}>
	<GrainyGradient colorBg="#f0fbf8" colorA="#45ccaa" colorB="#6FB18A" colorC="#EDB74D" class="info-page">
		<Thanks />
	</GrainyGradient>
</BaseLayout>
