  }
</style>

<script>
  function setupPauta() {
    // Format COP
    function fmtCOP(n: number) {
      return '$' + n.toLocaleString('es-CO').replace(/,/g, '.');
    }

    const calcBudget = document.getElementById('calc-budget') as HTMLInputElement;
    const calcPackage = document.getElementById('calc-package') as HTMLSelectElement;
    const calcCampaigns = document.getElementById('calc-campaigns') as HTMLSelectElement;
    const addonStatic = document.getElementById('addon-static') as HTMLInputElement;
    const addonVideo = document.getElementById('addon-video') as HTMLInputElement;
    
    if (!calcBudget) return;

    function calcUpdate() {
      const pkg = parseInt(calcPackage.value);
      const campaigns = parseInt(calcCampaigns.value);
      const budget = parseInt(calcBudget.value);
      const staticAddon = addonStatic.checked ? 180000 * campaigns : 0;
      const videoAddon = addonVideo.checked ? 120000 * campaigns : 0;

      // Auto-switch package if campaigns exceed limit
      if (campaigns > 3 && calcPackage.value === '950000') {
        calcPackage.value = '1200000';
      }

      const fee = parseInt(calcPackage.value) + staticAddon + videoAddon;
      const total = fee + budget;

      const budgetDisplay = document.getElementById('budget-display');
      const resFee = document.getElementById('res-fee');
      const resPauta = document.getElementById('res-pauta');
      const resTotal = document.getElementById('res-total');

      if(budgetDisplay) budgetDisplay.textContent = fmtCOP(budget);
      if(resFee) resFee.textContent = fmtCOP(fee);
      if(resPauta) resPauta.textContent = fmtCOP(budget);
      if(resTotal) resTotal.textContent = fmtCOP(total);
    }

    calcBudget.addEventListener('input', calcUpdate);
    calcPackage.addEventListener('change', calcUpdate);
    calcCampaigns.addEventListener('change', calcUpdate);
    addonStatic.addEventListener('change', calcUpdate);
    addonVideo.addEventListener('change', calcUpdate);
    calcUpdate();

    // FAQ
    document.querySelectorAll('.faq-q').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.parentElement;
        if(!item) return;
        const answer = item.querySelector('.faq-a') as HTMLElement;
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item.open').forEach(el => {
          el.classList.remove('open');
          const a = el.querySelector('.faq-a') as HTMLElement;
          if(a) a.style.maxHeight = '0';
        });
        if (!isOpen) {
          item.classList.add('open');
          if(answer) answer.style.maxHeight = answer.scrollHeight + 'px';
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPauta);
  } else {
    setupPauta();
  }
  document.addEventListener('astro:page-load', setupPauta);
</script>
