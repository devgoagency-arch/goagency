---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ScrollArrow from "@components/global/ScrollArrow.astro";
import { Icon } from "astro-icon/components";
import type { AstroSeoProps } from "@astrolib/seo";

const seoProps: AstroSeoProps = {
  title: "Tu negocio puede conseguir clientes por internet. | Pauta Digital GO Agency",
  description: "No importa el sector. Si tienes clientes, tienes una audiencia que puedes alcanzar. Diseñamos la estrategia y gestionamos las campañas. Sin presupuesto quemado.",
  openGraph: {
    title: "Tu negocio puede conseguir clientes por internet. | Pauta Digital",
    description: "No importa el sector. Si tienes clientes, tienes una audiencia que puedes alcanzar. Diseñamos la estrategia y gestionamos las campañas. Sin presupuesto quemado.",
    images: [
      {
        url: "https://goestrategiacreativa.com/og-pauta-digital.jpg",
        width: 1200,
        height: 630,
        alt: "Go Agency - Pauta Digital para Empresas",
      }
    ]
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Por qué mínimo 3 meses de permanencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Porque las campañas necesitan tiempo para aprender y optimizarse. El algoritmo de Meta o Google tarda entre 2 y 4 semanas en acumular datos suficientes. Si paras antes, no sabes si la estrategia funciona — solo sabes que no le diste tiempo. Después de los 3 meses, continúas mes a mes y puedes cancelar con 15 días de anticipación."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto debo invertir en pauta?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El presupuesto de pauta es tuyo y va directo a la plataforma. Nosotros no lo manejamos. Te recomendamos un mínimo según tu sector y objetivos, pero lo decides tú. Con nuestra calculadora puedes estimar un punto de partida."
      }
    },
    {
      "@type": "Question",
      "name": "¿Por qué hasta 3 campañas en el paquete base y no solo 1?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Una sola campaña solo puede hacer una cosa a la vez. El escenario mínimo viable para la mayoría de negocios es: llegar a gente nueva + hacer retargeting a quienes ya te visitaron. Eso ya son 2 campañas con lógicas distintas. La tercera puede ser para una segunda plataforma o un objetivo diferente. No activamos más campañas de las necesarias — el número exacto lo definimos en la estrategia."
      }
    },
    {
      "@type": "Question",
      "name": "¿Funciona la pauta digital para negocios B2B o de nicho?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. Google Ads y Meta Ads permiten segmentar por cargo, industria, comportamiento e intención de búsqueda. Si tus clientes usan internet — y lo hacen — hay una forma de llegar a ellos con pauta bien diseñada. No existe un sector no apto, solo estrategias mal diseñadas."
      }
    },
    {
      "@type": "Question",
      "name": "¿Puedo combinar plataformas dentro del mismo paquete?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. Puedes tener campañas en Meta Ads, Google Ads y TikTok Ads dentro del mismo paquete si tiene sentido estratégico. Lo evaluamos antes de configurar cualquier cosa."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué pasa si quiero más de 5 campañas?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Contáctanos y diseñamos un plan a la medida. Para volúmenes más altos o campañas continuas, tenemos esquemas de gestión personalizados."
      }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Pauta Digital y Gestión de Campañas",
  "provider": {
    "@type": "ProfessionalService",
    "name": "Go Agency",
    "image": "https://goestrategiacreativa.com/GoAgencyIcon.webp",
    "url": "https://goestrategiacreativa.com"
  },
  "areaServed": "Global",
  "description": "Diseñamos la estrategia, configuramos y gestionamos tus campañas en Meta Ads, Google Ads, TikTok Ads y más.",
  "offers": {
    "@type": "Offer",
    "price": "950000",
    "priceCurrency": "COP"
  }
};
---

<BaseLayout
	seo={seoProps}
	pageSlug="servicios/pauta-digital"
	waPhone="573107541645"
	waDefaultText="Hablemos"
	waHoverText="Hablemos &rarr;"
	waMessage="Hola Alejandra, estoy interesad@ en la Pauta Digital que vi en tu página :)"
	cursorColor="#45ccaa"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

<!-- HERO -->
  <section id="hero" class="relative w-full min-h-screen flex flex-col justify-center py-16 lg:py-20 bg-white text-black border-b border-zinc-200">
    <div class="mx-auto max-w-7xl px-4 md:px-8 flex flex-col items-center justify-center text-center">
      <span class="mb-8 text-xs uppercase tracking-[0.2em] text-[#45ccaa] font-mono">Pauta Digital para Empresas</span>
      <h1 class="font-display text-5xl sm:text-6xl lg:text-[5.25rem] font-bold leading-[1.1] tracking-tight mb-8">
        Tu negocio puede<br />conseguir clientes<br />por internet.
      </h1>
      <p class="font-sans text-xl lg:text-2xl font-light text-zinc-600 leading-relaxed max-w-3xl mb-12">
        No importa el sector. Si tienes clientes, tienes una audiencia que puedes alcanzar. Diseñamos la estrategia y gestionamos las campañas. Sin presupuesto quemado.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="https://wa.me/573107541645?text=Hola%2C%20quiero%20una%20asesoría%20gratuita%20sobre%20pauta%20digital" class="inline-flex items-center justify-center rounded-full bg-black text-white px-8 py-4 text-sm font-semibold uppercase tracking-widest transition-opacity hover:opacity-90">
          Quiero una asesoría gratuita
        </a>
        <a href="#calculadora" class="inline-flex items-center justify-center rounded-full border border-zinc-300 px-8 py-4 text-sm font-semibold uppercase tracking-widest text-black transition-colors hover:border-black hover:bg-black hover:text-white">
          Calcular mi inversión →
        </a>
      </div>
    </div>
    
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 z-10 flex justify-center pointer-events-none w-full">
      <div class="pointer-events-auto -my-10">
        <ScrollArrow targetId="#problema" color="#45ccaa" id="hero-arrow" />
      </div>
    </div>
  </section>

  <!-- DOLOR -->
  <section id="problema" class="relative w-full py-16 lg:py-20 bg-zinc-900 text-white border-b border-zinc-800">
    <div class="mx-auto max-w-7xl px-4 md:px-8">
      <div class="mb-16">
        <span class="text-xs uppercase tracking-[0.2em] text-[#45ccaa] font-mono">El problema real</span>
      </div>
      <div class="font-sans font-light text-zinc-300 leading-relaxed max-w-4xl space-y-8">
        <p class="text-[24px]">"La pauta digital no es para mi negocio." — Eso es lo que creían muchos de nuestros clientes <strong class="text-white font-semibold">antes</strong> de trabajar con nosotros.</p>
        <p class="text-[24px]">Constructoras, clínicas, distribuidoras, firmas jurídicas, colegios, restaurantes, laboratorios. Todas tienen algo en común: <strong class="text-white font-semibold">sus clientes ideales están en internet</strong>, y la mayoría de sus competidores todavía no sabe cómo llegar a ellos.</p>
        <p class="text-[24px]">No importa si tu negocio es técnico, de nicho o "poco visual". Si tienes algo que vender, hay una forma inteligente de anunciarlo.</p>
      </div>
      <div class="mt-12 border-l-4 border-white pl-6">
        <p class="font-display text-3xl lg:text-4xl font-bold text-white">El problema no es el sector. El problema es no tener estrategia.</p>
      </div>
    </div>

    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 z-10 flex justify-center pointer-events-none w-full">
      <div class="pointer-events-auto -my-10">
        <ScrollArrow targetId="#como-trabajamos" color="#45ccaa" />
      </div>
    </div>
  </section>

  <!-- VALUE PROPS -->
  <section id="como-trabajamos" class="relative w-full py-16 lg:py-20 bg-[#18181b] text-white border-b border-zinc-800">
    <div class="mx-auto max-w-7xl px-4 md:px-8">
      <div class="mb-16">
        <span class="text-xs uppercase tracking-[0.2em] text-[#45ccaa] font-mono">Cómo trabajamos</span>
      </div>
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.1] tracking-tight mb-16 max-w-4xl">
        Lo que incluye trabajar con nosotros.
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
        <div class="flex flex-col bg-[#272521]/40 rounded-2xl p-6 md:p-8 border border-zinc-800/50 hover:border-zinc-700/80 transition-colors">
          <p class="text-xs font-mono tracking-widest text-[#45ccaa] mb-6">01</p>
          <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight mb-4">Estrategia antes de gastar un peso.</h3>
          <p class="font-sans text-sm md:text-base text-zinc-300 leading-relaxed">Analizamos tu audiencia, competencia y canales. Nada se activa sin criterio.</p>
        </div>
        <div class="flex flex-col bg-[#272521]/40 rounded-2xl p-6 md:p-8 border border-zinc-800/50 hover:border-zinc-700/80 transition-colors">
          <p class="text-xs font-mono tracking-widest text-[#45ccaa] mb-6">02</p>
          <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight mb-4">Setup y configuración técnica.</h3>
          <p class="font-sans text-sm md:text-base text-zinc-300 leading-relaxed">Objetivo, segmentación, presupuesto, pujas y pixel de conversión configurados correctamente desde el inicio.</p>
        </div>
        <div class="flex flex-col bg-[#272521]/40 rounded-2xl p-6 md:p-8 border border-zinc-800/50 hover:border-zinc-700/80 transition-colors">
          <p class="text-xs font-mono tracking-widest text-[#45ccaa] mb-6">03</p>
          <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight mb-4">Gestión y optimización continua.</h3>
          <p class="font-sans text-sm md:text-base text-zinc-300 leading-relaxed">Monitoreamos, ajustamos y optimizamos cada semana para que el algoritmo trabaje a tu favor.</p>
        </div>
        <div class="flex flex-col bg-[#272521]/40 rounded-2xl p-6 md:p-8 border border-zinc-800/50 hover:border-zinc-700/80 transition-colors">
          <p class="text-xs font-mono tracking-widest text-[#45ccaa] mb-6">04</p>
          <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight mb-4">Reunión semanal por videollamada.</h3>
          <p class="font-sans text-sm md:text-base text-zinc-300 leading-relaxed">Te mostramos qué está pasando, qué ajustamos y cuáles son los próximos pasos. Sin letra pequeña.</p>
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 z-10 flex justify-center pointer-events-none w-full">
      <div class="pointer-events-auto -my-10">
        <ScrollArrow targetId="#paquetes" color="#45ccaa" />
      </div>
    </div>
  </section>

  <!-- PACKAGES -->
  <section id="paquetes" class="relative w-full py-16 lg:py-20 bg-zinc-900 text-white border-b border-zinc-800">
    <div class="mx-auto max-w-7xl px-4 md:px-8">
      <div class="mb-8">
        <span class="text-xs uppercase tracking-[0.2em] text-[#45ccaa] font-mono">Paquetes</span>
      </div>
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.1] tracking-tight mb-8 max-w-4xl">
        Elige el paquete que se ajusta a tus objetivos.
      </h2>
      <p class="font-sans text-xl font-light text-zinc-300 max-w-3xl mb-16 leading-relaxed">
        Gestión mensual con setup incluido. El presupuesto de pauta lo pagas directamente a la plataforma — no pasa por nosotros.
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 mb-16">
        <div class="flex flex-col bg-[#272521]/40 rounded-2xl p-8 lg:p-12 border border-zinc-800/50 hover:border-zinc-700/80 transition-colors relative">
          <p class="text-xs uppercase tracking-[0.2em] text-[#45ccaa] font-mono mb-4">Paquete Base</p>
          <h3 class="font-display text-3xl md:text-4xl font-bold tracking-tight mb-4">Hasta 3 Campañas</h3>
          <p class="font-sans text-zinc-300 font-light mb-8 leading-relaxed">El escenario mínimo viable para la mayoría de negocios: una campaña para llegar a gente nueva, una para hacer retargeting a quienes ya te vieron, y una tercera para un segundo objetivo o plataforma.</p>
          <ul class="space-y-4 mb-12 flex-1">
            <li class="flex items-start gap-3 font-light text-zinc-300 border-b border-zinc-800/50 pb-3"><span class="text-[#45ccaa]">→</span> Diseño de estrategia de pauta</li>
            <li class="flex items-start gap-3 font-light text-zinc-300 border-b border-zinc-800/50 pb-3"><span class="text-[#45ccaa]">→</span> Setup inicial incluido</li>
            <li class="flex items-start gap-3 font-light text-zinc-300 border-b border-zinc-800/50 pb-3"><span class="text-[#45ccaa]">→</span> Gestión de hasta 3 campañas</li>
            <li class="flex items-start gap-3 font-light text-zinc-300 border-b border-zinc-800/50 pb-3"><span class="text-[#45ccaa]">→</span> Hasta 2â€“3 anuncios por campaña</li>
            <li class="flex items-start gap-3 font-light text-zinc-300 border-b border-zinc-800/50 pb-3"><span class="text-[#45ccaa]">→</span> Optimización continua</li>
            <li class="flex items-start gap-3 font-light text-zinc-300 border-b border-zinc-800/50 pb-3"><span class="text-[#45ccaa]">→</span> Reunión semanal de 30 min (videollamada)</li>
            <li class="flex items-start gap-3 font-light text-zinc-300"><span class="text-[#45ccaa]">→</span> Reporte mensual de resultados</li>
          </ul>
          <div>
            <div class="mb-2"><span class="font-display text-4xl font-bold text-white">$950.000</span> <span class="text-zinc-400 font-light">/ mes</span></div>
            <p class="text-sm text-zinc-500 mb-4">+ pauta publicitaria (va directo a la plataforma)</p>
            <p class="text-xs text-zinc-500 pt-4 border-t border-zinc-800/50">Permanencia mínima: 3 meses · Luego mes a mes · Cancelación con 15 días de aviso</p>
            <a href="https://wa.me/573107541645?text=Hola%2C%20me%20interesa%20el%20Paquete%20Base%20de%20pauta%20digital" class="mt-8 block text-center rounded-full border border-zinc-500 px-8 py-4 text-sm font-semibold uppercase tracking-widest text-zinc-300 transition-colors hover:border-white hover:bg-white hover:text-black">
              Quiero este paquete
            </a>
          </div>
        </div>

        <div class="flex flex-col bg-[#272521]/40 rounded-2xl p-8 lg:p-12 border border-zinc-800/50 hover:border-zinc-700/80 transition-colors relative">
          <p class="text-xs uppercase tracking-[0.2em] text-[#45ccaa] font-mono mb-4">Paquete Estratégico</p>
          <h3 class="font-display text-3xl md:text-4xl font-bold tracking-tight mb-4">Hasta 5 Campañas</h3>
          <p class="font-sans text-zinc-300 font-light mb-8 leading-relaxed">Cuando una empresa ya tiene claridad o quiere escalar, necesita más frentes: awareness, consideración, conversión, retargeting y, en muchos casos, más de una plataforma al mismo tiempo.</p>
          <ul class="space-y-4 mb-12 flex-1">
            <li class="flex items-start gap-3 font-light text-zinc-300 border-b border-zinc-800/50 pb-3"><span class="text-[#45ccaa]">→</span> Todo lo del Paquete Base</li>
            <li class="flex items-start gap-3 font-light text-zinc-300 border-b border-zinc-800/50 pb-3"><span class="text-[#45ccaa]">→</span> Gestión de hasta 5 campañas</li>
            <li class="flex items-start gap-3 font-light text-zinc-300 border-b border-zinc-800/50 pb-3"><span class="text-[#45ccaa]">→</span> Hasta 2â€“3 anuncios por campaña</li>
            <li class="flex items-start gap-3 font-light text-zinc-300 border-b border-zinc-800/50 pb-3"><span class="text-[#45ccaa]">→</span> Estrategia multi-canal o multi-objetivo</li>
            <li class="flex items-start gap-3 font-light text-zinc-300 border-b border-zinc-800/50 pb-3"><span class="text-[#45ccaa]">→</span> Optimización continua intensiva</li>
            <li class="flex items-start gap-3 font-light text-zinc-300 border-b border-zinc-800/50 pb-3"><span class="text-[#45ccaa]">→</span> Reunión semanal de 30 min (videollamada)</li>
            <li class="flex items-start gap-3 font-light text-zinc-300"><span class="text-[#45ccaa]">→</span> Reporte detallado con análisis de desempeño</li>
          </ul>
          <div>
            <div class="mb-2"><span class="font-display text-4xl font-bold text-white">$1.200.000</span> <span class="text-zinc-400 font-light">/ mes</span></div>
            <p class="text-sm text-zinc-500 mb-4">+ pauta publicitaria (va directo a la plataforma)</p>
            <p class="text-xs text-zinc-500 pt-4 border-t border-zinc-800/50">Permanencia mínima: 3 meses · Luego mes a mes · Cancelación con 15 días de aviso</p>
            <a href="https://wa.me/573107541645?text=Hola%2C%20me%20interesa%20el%20Paquete%20Estratégico%20de%20pauta%20digital" class="mt-8 block text-center rounded-full bg-[#45ccaa] px-8 py-4 text-sm font-semibold uppercase tracking-widest text-black transition-opacity hover:opacity-90">
              Quiero este paquete
            </a>
          </div>
        </div>
      </div>

      <!-- Addons box -->
      <div class="flex flex-col bg-[#272521]/40 rounded-2xl p-8 lg:p-12 border border-zinc-800/50">
        <p class="text-xs uppercase tracking-[0.2em] text-[#45ccaa] font-mono mb-4">Servicio adicional opcional</p>
        <h3 class="font-display text-2xl lg:text-3xl font-bold tracking-tight mb-4 text-white">¿No tienes las creatividades listas?</h3>
        <p class="font-sans text-sm md:text-base text-zinc-300 max-w-3xl mb-12 leading-relaxed">
          Los paquetes de gestión no incluyen diseño — así el precio base solo cubre lo que todos necesitan. Si necesitas que GO diseñe las piezas, agrégalo por campaña.
        </p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
          <div class="flex flex-col border border-zinc-800/50 rounded-2xl p-8">
            <span class="inline-block border border-zinc-700 text-[#45ccaa] text-[10px] font-bold uppercase tracking-[0.2em] px-3 py-1 mb-6 rounded-full w-fit">Add-on A — Piezas estáticas</span>
            <h4 class="font-display text-xl font-bold mb-3 tracking-tight">Diseño de imágenes para anuncios</h4>
            <p class="text-sm font-light text-zinc-400 italic mb-6">Para Meta Ads, Google Display, Pinterest o Twitter/X.</p>
            <ul class="space-y-3 mb-8">
              <li class="flex items-start gap-2 text-sm font-light text-zinc-300 border-b border-zinc-800/50 pb-2"><span class="text-[#45ccaa]">→</span> 3 creatividades por campaña</li>
              <li class="flex items-start gap-2 text-sm font-light text-zinc-300 border-b border-zinc-800/50 pb-2"><span class="text-[#45ccaa]">→</span> 1 imagen estática + 1 versión stories/vertical + 1 variación A/B</li>
              <li class="flex items-start gap-2 text-sm font-light text-zinc-300 border-b border-zinc-800/50 pb-2"><span class="text-[#45ccaa]">→</span> Redacción de copy para cada pieza</li>
              <li class="flex items-start gap-2 text-sm font-light text-zinc-300"><span class="text-[#45ccaa]">→</span> Adaptación a los formatos de la plataforma</li>
            </ul>
            <div class="font-display text-2xl font-bold text-white mt-auto">+$180.000 <span class="text-sm font-sans font-light text-zinc-400">por campaña / mes</span></div>
          </div>
          <div class="flex flex-col border border-zinc-800/50 rounded-2xl p-8">
            <span class="inline-block border border-zinc-700 text-[#45ccaa] text-[10px] font-bold uppercase tracking-[0.2em] px-3 py-1 mb-6 rounded-full w-fit">Add-on B — Video para pauta</span>
            <h4 class="font-display text-xl font-bold mb-3 tracking-tight">Adaptación de video para anuncios</h4>
            <p class="text-sm font-light text-zinc-400 italic mb-6">Para TikTok Ads, YouTube Ads o Meta Reels.</p>
            <ul class="space-y-3 mb-8">
              <li class="flex items-start gap-2 text-sm font-light text-zinc-300 border-b border-zinc-800/50 pb-2"><span class="text-[#45ccaa]">→</span> Hasta 3 versiones de video por campaña</li>
              <li class="flex items-start gap-2 text-sm font-light text-zinc-300 border-b border-zinc-800/50 pb-2"><span class="text-[#45ccaa]">→</span> El cliente aporta el material de video</li>
              <li class="flex items-start gap-2 text-sm font-light text-zinc-300 border-b border-zinc-800/50 pb-2"><span class="text-[#45ccaa]">→</span> Adaptación: formato, proporción, texto superpuesto y subtítulos</li>
              <li class="flex items-start gap-2 text-sm font-light text-zinc-300"><span class="text-[#45ccaa]">→</span> Redacción de copy del anuncio · ¿Sin video? Cotizamos producción aparte</li>
            </ul>
            <div class="font-display text-2xl font-bold text-white mt-auto">+$120.000 <span class="text-sm font-sans font-light text-zinc-400">por campaña / mes</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 z-10 flex justify-center pointer-events-none w-full">
      <div class="pointer-events-auto -my-10">
        <ScrollArrow targetId="#calculadora" color="#45ccaa" />
      </div>
    </div>
  </section>

  <!-- CALCULATOR -->
  <section id="calculadora" class="relative w-full py-16 lg:py-20 bg-white text-black border-b border-zinc-200">
    <div class="mx-auto max-w-7xl px-4 md:px-8">
      <div class="mb-8">
        <span class="text-xs uppercase tracking-[0.2em] text-[#45ccaa] font-mono">Calculadora de inversión</span>
      </div>
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.1] tracking-tight mb-8">
        Estima cuánto pagarías cada mes.
