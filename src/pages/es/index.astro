---
export const prerender = true;

/**
 * /es/ – Home page (Español)
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@components/landing/Hero.astro";
import Services from "@components/landing/Services.astro";
import Tagline from "@components/landing/Tagline.astro";
import WorkPreview from "@components/landing/WorkPreview.astro";
import Faq from "@components/landing/Faq.astro";
import { getWPPage } from "@lib/wordpress";

let wpHome = null;
try {
	wpHome = await getWPPage("home", "es");
} catch {}
---

<BaseLayout
	wpPost={wpHome}
	fallbackTitle="Go Estrategia Creativa – Agencia Creativa"
	fallbackDescription="Transformamos marcas a través de estrategia creativa, diseño digital y contenido de impacto."
	pageSlug="">
	<Hero />
	<WorkPreview class="!pt-20 pb-20 lg:!pt-36 lg:pb-40" />
	<Services />
	<Tagline />
	<Faq />
</BaseLayout>
