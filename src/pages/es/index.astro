---
export const prerender = true;

/**
 * /es/ – Home page (Español)
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@components/landing/Hero.astro";
import Method from "@components/landing/Method.astro";
import OurArchitecture from "@components/landing/OurArchitecture.astro";
import TheTeam from "@components/landing/TheTeam.astro";
import WorkPreview from "@components/landing/WorkPreview.astro";
import HomeContact from "@components/landing/HomeContact.astro";
import { getWPPage } from "@lib/wordpress";

let wpHome = null;
try {
	wpHome = await getWPPage("home", "es");
} catch {}
---

<BaseLayout
	wpPost={wpHome}
	fallbackTitle="Go Estrategia Creativa – Agencia Creativa"
	fallbackDescription="Transformamos marcas a través de estrategia creativa, diseño digital y contenido de impacto."
	pageSlug="">
	<Hero />
	<Method />
	<WorkPreview class="pt-24 lg:pt-32 pb-12 lg:pb-16" />
	<OurArchitecture />
	<TheTeam />
	<HomeContact />
</BaseLayout>
