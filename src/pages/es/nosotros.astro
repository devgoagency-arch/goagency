---
export const prerender = true;

/**
 * /es/nosotros – About page (Español)
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import AboutSection from "@components/landing/About.astro";
import { getWPPage, getWPTeam, type WPTeamMember } from "@lib/wordpress";
import GrainyGradient from "@components/global/GrainyGradient.astro";

let wpPage = null;
let members: WPTeamMember[] = [];
try {
	[wpPage, members] = await Promise.all([getWPPage("nosotros", "es"), getWPTeam("es")]);
} catch {}
---

<BaseLayout
	wpPost={wpPage}
	fallbackTitle="Nosotros – Go Estrategia Creativa"
	fallbackDescription="Conoce a Alejandra y Nestor, el equipo detrás de Go Estrategia Creativa."
	pageSlug="nosotros"
	cursorColor="#45ccaa">
	<GrainyGradient colorBg="#f0fbf8" colorA="#45ccaa" colorB="#6FB18A" colorC="#EDB74D" class="nosotros-page">
		<AboutSection members={members} />
	</GrainyGradient>
</BaseLayout>
