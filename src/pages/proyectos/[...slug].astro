---
/**
 * /work/[...slug] – Proyecto individual — SSR dinámico
 * prerender = false → cada request hace un fetch fresco a WP
 */
export const prerender = false;

import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import {
	getWPProyectoBySlug,
	getImageUrl,
	getImageAlt,
	getClienteName,
	getProjectUrl,
	getProjectDate,
	getProjectRole,
	getProjectExcerpt,
	decodeWPHtml,
	getProjectChallenge,
	getProjectSolution,
	getProjectResult,
	getProjectPillars,
	processWPContent,
} from "@lib/wordpress";
import type { CollectionEntry } from "astro:content";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import GrainyGradient from "@components/global/GrainyGradient.astro";
import ResultsBlock from "@components/ResultsBlock.astro";

const { slug } = Astro.params;
const lang = getLangFromUrl(Astro.url) as "en" | "es";
const t = useTranslations(lang);

// ─── Datos del proyecto ──────────────────────
let title = "";
let content = "";
let imageUrl: string | null = null;
let imageAlt = "";
let projectUrl = "";
let clientName = "";
let projectDate = "";
let projectRole = "";
let projectExcerpt = "";
let projectChallenge = "";
let projectSolution = "";
let projectResult = "";
let projectPillars: { name: string; slug: string }[] = [];
let RenderedContent: any = null;
let wpProject: any = null;

// 1. ¿Existe en la colección MDX local?
const localProjects = await getCollection("projects");
const localProject =
	localProjects.find((prj) => {
		const parts = prj.id.split("/");
		const prjSlug = parts.length > 1 ? parts.slice(1).join("/") : parts[0];
		return prjSlug === slug;
	}) ?? null;

if (localProject) {
	const { Content } = await render(localProject);
	RenderedContent = Content;
	title = localProject.data.title;
	imageUrl = localProject.data.image?.source?.src ?? null;
	imageAlt = localProject.data.image?.alt ?? title;
	projectUrl = localProject.data.link ?? "";
	clientName = localProject.data.client ?? "";
	projectDate = localProject.data.date ?? "";
	projectRole = localProject.data.role ?? "";
	projectExcerpt = localProject.data.description ?? "";
	projectChallenge = localProject.data.challenge ?? "";
	projectSolution = localProject.data.solution ?? "";
	projectResult = localProject.data.result ?? "";
	projectPillars = (localProject.data.pillars ?? []).map((slug: string) => ({ name: slug, slug }));
} else {
	// 2. Fetch directo a WP (sin caché, contenido siempre fresco)
	wpProject = await getWPProyectoBySlug(slug as string);
	if (!wpProject) return Astro.redirect("/proyectos", 302);
	title = decodeWPHtml(wpProject.title);
	content = wpProject.content ?? "";
	imageUrl = getImageUrl(wpProject);
	imageAlt = getImageAlt(wpProject);
	projectUrl = getProjectUrl(wpProject);
	clientName = getClienteName(wpProject);
	projectDate = getProjectDate(wpProject);
	projectRole = getProjectRole(wpProject);
	projectExcerpt = getProjectExcerpt(wpProject);
	projectChallenge = getProjectChallenge(wpProject);
	projectSolution = getProjectSolution(wpProject);
	projectResult = getProjectResult(wpProject);
	projectPillars = getProjectPillars(wpProject);
}
---

<BaseLayout
	wpPost={wpProject}
	fallbackTitle={`${title} – Go Estrategia Creativa`}
	fallbackDescription={projectExcerpt || wpProject?.excerpt || localProject?.data.description || ""}
	pageSlug={`work/${slug}`}
	cursorColor="#45ccaa">
	<GrainyGradient colorBg="#f0fbf8" colorA="#45ccaa" colorB="#6FB18A" colorC="#EDB74D" class="proyecto-detalle">
		<article class="section !pt-32 !pb-24 lg:!pt-40 lg:!pb-32">
			<div class="col-span-12 mx-auto max-w-7xl w-full">
				<div class="grid grid-cols-1 gap-12 lg:grid-cols-[30%_70%] lg:gap-16 w-full">
					
					<!-- Column A: 30% - Sidebar Content (Simple, divided by lines) -->
					<aside class="w-full lg:sticky lg:top-32 lg:self-start lg:pr-3">
						<!-- Project Title -->
						<h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold uppercase tracking-tight leading-tight text-zinc-950 mb-4">{title}</h1>

						<!-- Pillar pills -->
						{projectPillars.length > 0 && (
							<div class="flex flex-wrap gap-2 mb-8">
								{projectPillars.map((p) => (
									<span class="inline-flex items-center px-3 py-1 rounded-full text-[0.6rem] font-bold uppercase tracking-widest border border-[#45ccaa]/40 text-[#45ccaa] bg-[#45ccaa]/10">
										{p.name}
									</span>
								))}
							</div>
						)}

						<!-- ACF Metadata fields with simple line divisions -->
						<div class="flex flex-col divide-y divide-stone-200/80">
							
							{clientName?.trim() && (
								<div class="py-4 first:pt-0">
									<span class="text-[0.65rem] font-bold uppercase tracking-widest text-stone-400 block mb-1">
										{lang === "es" ? "Cliente" : "Client"}
									</span>
									<p class="text-base font-bold text-zinc-900 leading-snug">{clientName}</p>
								</div>
							)}

							{projectChallenge?.trim() && (
								<div class="py-4 first:pt-0">
									<span class="text-[0.65rem] font-bold uppercase tracking-widest text-[#45ccaa] block mb-1">
										{lang === "es" ? "El Desafío" : "The Challenge"}
									</span>
									<p class="text-stone-600 text-sm leading-relaxed font-light">{projectChallenge}</p>
								</div>
							)}

							{projectSolution?.trim() && (
								<div class="py-4 first:pt-0">
									<span class="text-[0.65rem] font-bold uppercase tracking-widest text-[#EDB74D] block mb-1">
										{lang === "es" ? "La Solución" : "The Solution"}
									</span>
									<p class="text-stone-600 text-sm leading-relaxed font-light">{projectSolution}</p>
								</div>
							)}

							{projectResult?.trim() && (
								<div class="py-4 first:pt-0">
									<span class="text-[0.65rem] font-bold uppercase tracking-widest text-[#6FB18A] block mb-1">
										{lang === "es" ? "El Resultado" : "The Result"}
									</span>
									<p class="text-stone-600 text-sm leading-relaxed font-light">{projectResult}</p>
								</div>
							)}

							{(projectDate?.trim() || projectRole?.trim()) && (
								<div class="py-4 first:pt-0 space-y-4">
									{projectDate?.trim() && (
										<div>
											<span class="text-[0.65rem] font-bold uppercase tracking-widest text-stone-400 block mb-1">
												{lang === "es" ? "Fecha" : "Date"}
											</span>
											<p class="text-sm font-medium text-stone-700">{projectDate}</p>
										</div>
									)}

									{projectRole?.trim() && (
										<div class={projectDate?.trim() ? "border-t border-stone-100 pt-3" : ""}>
											<span class="text-[0.65rem] font-bold uppercase tracking-widest text-stone-400 block mb-1">
												{lang === "es" ? "Rol / Servicios" : "Role / Services"}
											</span>
											<p class="text-sm font-medium text-stone-700">{projectRole}</p>
										</div>
									)}
								</div>
							)}

							{projectUrl?.trim() && (
								<div class="py-4 first:pt-0 flex justify-start">
									<a href={projectUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 text-xs font-bold uppercase tracking-widest text-white bg-[#45ccaa] hover:bg-[#3ab899] transition-all rounded-full group">
										<span>{lang === "es" ? "Visitar Proyecto" : "Visit Project"}</span>
										<span class="inline-block transition-transform group-hover:translate-x-1 group-hover:-translate-y-1">↗</span>
									</a>
								</div>
							)}
						</div>
					</aside>

					<!-- Column B: 70% - Main content -->
					<div class="w-full space-y-12">

						<!-- WordPress content or MDX content -->
						{
							RenderedContent ? (
								<div class="wp-content prose-styles !max-w-none">
									<RenderedContent components={{ ResultsBlock }} />
								</div>
							) : content ? (
								<div class="wp-content prose-styles !max-w-none" set:html={processWPContent(content)} />
							) : projectExcerpt ? (
								<div class="wp-content prose-styles !max-w-none" set:html={processWPContent(projectExcerpt)} />
							) : null
						}

						<!-- Footer Navigation -->
						<div class="footer-nav mt-16 flex flex-col items-start gap-4 border-t border-stone-200 pt-8 sm:flex-row sm:items-center">
							{
								projectUrl && (
									<a
										href={projectUrl}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-2 rounded-lg px-6 py-3 font-semibold text-white transition-colors"
										style="background-color: #45ccaa;">
										{t("blog.gotoproject")} ↗
									</a>
								)
							}
							<a href="/proyectos" class="text-stone-400 transition-colors hover:text-stone-700">
								← {t("projects")}
							</a>
						</div>
					</div>
					
				</div>
			</div>
		</article>
	</GrainyGradient>
</BaseLayout>

<script>
	class ResultsBlock extends HTMLElement {
		connectedCallback() {
			// Evitar doble renderizado si Astro ya lo renderizó (MDX)
			if (this.querySelector('.results-block')) return;

			const statsAttr = this.getAttribute('stats');
			const noteAttr = this.getAttribute('note');
			
			if (!statsAttr) return;

			let stats = [];
			try {
				// Reemplazar posibles comillas y etiquetas <br> que inyecta WordPress por los saltos de línea
				const cleanStats = statsAttr
					.replace(/<br\s*\/?>/gi, '') // Quitar los <br />
					.replace(/<p>/gi, '')        // Quitar los <p>
					.replace(/<\/p>/gi, '')      // Quitar los </p>
					.replace(/&quot;/g, '"')
					.replace(/”/g, '"')
					.replace(/“/g, '"')
					.replace(/[\u2018\u2019]/g, "'")
					.replace(/[\u201C\u201D]/g, '"')
					.replace(/&nbsp;/g, ' ')
					.replace(/[\r\n\t]/g, '');   // Quitar saltos de línea literales
				stats = JSON.parse(cleanStats);
			} catch (e) {
				console.error("Error parsing stats JSON in results-block", e);
				this.innerHTML = `<div style="color:red; background:#fff0f0; padding:15px; border:2px solid red; border-radius:8px; margin: 20px 0; font-family: monospace; font-size: 12px; overflow-wrap: break-word;">
					<strong>Error de sintaxis en el JSON de esta página:</strong><br/>
					${e.message}<br/><br/>
					<strong>Texto que intentó procesar:</strong><br/>
					${cleanStats}
				</div>`;
				return;
			}

			const statsHtml = stats.map((stat) => `
				<div class="stat-item flex flex-col gap-2 py-6 first:pt-0 last:pb-0 w-full">
					<span class="stat-number font-display text-3xl sm:text-4xl font-light tracking-tight text-[#45ccaa] whitespace-nowrap">
						${stat.number}
					</span>
					<span class="stat-label font-sans text-[10px] sm:text-xs font-normal text-stone-500 uppercase tracking-wide" style="font-family: 'Montserrat', sans-serif;">
						${stat.label}
					</span>
				</div>
			`).join('');

			const noteHtml = noteAttr ? `
				<div class="note-container mt-6 pt-6 border-t border-stone-200/80">
					<p class="font-sans text-[11px] sm:text-xs font-light text-stone-500 leading-relaxed italic" style="font-family: 'Montserrat', sans-serif;">
						${noteAttr}
					</p>
				</div>
			` : '';

			this.innerHTML = `
				<div class="results-block p-8 sm:p-10 my-10 bg-white/70 backdrop-blur-md shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-stone-200/50" style="border-radius: 10px;">
					<div class="flex flex-col divide-y divide-stone-200/80">
						${statsHtml}
					</div>
					${noteHtml}
				</div>
			`;
		}
	}

	if (!customElements.get('results-block')) {
		customElements.define('results-block', ResultsBlock);
	}
</script>

<style is:global>
	.proyecto-detalle {
		overflow: visible !important;
	}
</style>
