---
export const prerender = true;

/**
 * /proyectos – Listado completo de proyectos
 * Mismo layout 2 columnas escalonadas + GrainyGradient que el Home
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import WokCard from "@components/work/WokCard.astro";
import Title from "@components/global/Title.astro";
import GrainyGradient from "@components/global/GrainyGradient.astro";
import { getWPProyectos, getWPProyectosPage, getImageUrl, getProjectExcerpt, getProjectChallenge, getProjectResult, getProjectPillars, decodeWPHtml } from "@lib/wordpress";
import { useTranslations, getLangFromUrl } from "@i18n/utils";
import type { WPPost } from "@lib/wordpress";

const lang = getLangFromUrl(Astro.url) as "en" | "es";
const t = useTranslations(lang);

let wpPage = null;
let projects: WPPost[] = [];

try {
	[wpPage, projects] = await Promise.all([getWPProyectosPage(), getWPProyectos(50)]);
} catch {}
---

<BaseLayout
	wpPost={wpPage}
	fallbackTitle="Proyectos – Go Estrategia Creativa"
	fallbackDescription="Nuestro portafolio de estrategia creativa, branding y proyectos digitales."
	pageSlug="proyectos">
	<GrainyGradient colorBg="#f0fbf8" colorA="#45ccaa" colorB="#6FB18A" colorC="#EDB74D" class="proyectos-page">
		<section class="section proyectos-section py-20 lg:py-32">
			<div class="col-span-12 col-start-1 mx-auto max-w-7xl">
				<Title title={t("projects")} subtitle={t("projects.subtitle")} class="pb-10 pt-20 uppercase" />

				<div class="hidden">
				md:col-start-1 md:col-start-2 md:row-span-2
				md:row-start-1 md:row-start-2 md:row-start-3 md:row-start-4 md:row-start-5 
				md:row-start-6 md:row-start-7 md:row-start-8 md:row-start-9 md:row-start-10
				md:row-start-11 md:row-start-12 md:row-start-13 md:row-start-14 md:row-start-15
				md:row-start-16 md:row-start-17 md:row-start-18 md:row-start-19 md:row-start-20
				md:row-start-21 md:row-start-22 md:row-start-23 md:row-start-24 md:row-start-25
				md:row-start-26 md:row-start-27 md:row-start-28 md:row-start-29 md:row-start-30
				md:row-start-31 md:row-start-32 md:row-start-33 md:row-start-34 md:row-start-35
				md:row-start-36 md:row-start-37 md:row-start-38 md:row-start-39 md:row-start-40
				md:row-start-41 md:row-start-42 md:row-start-43 md:row-start-44 md:row-start-45
				md:row-start-46 md:row-start-47 md:row-start-48 md:row-start-49 md:row-start-50
				</div>
				{
					projects.length > 0 ? (
						<ol class="mt-24 grid grid-cols-1 gap-24 md:grid-cols-2 lg:mt-32 lg:gap-44">
							{projects.map((project, index) => {
								const imageUrl = getImageUrl(project);
								const title = decodeWPHtml(project.title);
								const description = getProjectExcerpt(project);
								const challenge = getProjectChallenge(project);
								const result = getProjectResult(project);
								const pillars = getProjectPillars(project);
								const isEven = index % 2 === 0;

								return (
									<WokCard
										imageUrl={imageUrl}
										project={title}
										link={`/proyectos/${project.id}`}
										description={description}
										challenge={challenge}
										result={result}
										pillars={pillars}
										content={project.content}
										class={
											isEven
												? `md:col-start-1 md:row-start-${Math.floor(index / 2) * 2 + 1} md:row-span-2`
												: `md:col-start-2 md:row-start-${Math.floor(index / 2) * 2 + 2} md:row-span-2`
										}
									/>
								);
							})}
						</ol>
					) : (
						<p class="mt-24 py-20 text-center text-stone-400">No hay proyectos publicados aún.</p>
					)
				}
			</div>
		</section>
	</GrainyGradient>
</BaseLayout>

<style is:global>
	.proyectos-page {
		min-height: 100vh;
	}
	.proyectos-section ol li img {
		--clip: 0%;
		clip-path: inset(var(--clip) round 0.5rem);
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	function init() {
		const previews = gsap.utils.toArray(".proyectos-section ol li img") as gsap.DOMTarget[];
		previews.forEach((preview) => {
			gsap.from(preview, {
				scrollTrigger: {
					trigger: preview,
					start: "top bottom",
					end: "center center",
					scrub: 1,
				},
				ease: "power3.out",
				"--clip": "30%",
			});
		});

		if (window.innerWidth >= 768) {
			const items = gsap.utils.toArray(".proyectos-section ol li") as gsap.DOMTarget[];
			items.forEach((item) => {
				gsap.to(item, {
					scrollTrigger: {
						trigger: ".proyectos-section ol",
						start: "top bottom",
						end: "bottom center",
						scrub: 1,
					},
					ease: "none",
					y: "-200px",
				});
			});
		}
	}

	document.removeEventListener("DOMContentLoaded", init);
	document.addEventListener("DOMContentLoaded", init);
</script>
