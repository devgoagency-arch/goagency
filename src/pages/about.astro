---
export const prerender = true;

/**
 * /about – About page (English)
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import AboutSection from "@components/landing/About.astro";
import { getWPPage, getWPTeam, type WPTeamMember } from "@lib/wordpress";
import GrainyGradient from "@components/global/GrainyGradient.astro";

let wpPage = null;
let members: WPTeamMember[] = [];
try {
	[wpPage, members] = await Promise.all([getWPPage("about", "en"), getWPTeam("en")]);
} catch {}
---

<BaseLayout
	wpPost={wpPage}
	fallbackTitle="About Us – Go Estrategia Creativa"
	fallbackDescription="Meet Alejandra and Nestor, the team behind Go Estrategia Creativa."
	pageSlug="about"
	cursorColor="#45ccaa">
	<GrainyGradient colorBg="#f0fbf8" colorA="#45ccaa" colorB="#6FB18A" colorC="#EDB74D" class="nosotros-page">
		<AboutSection members={members} />
	</GrainyGradient>
</BaseLayout>
