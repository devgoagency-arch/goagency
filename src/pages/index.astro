---
export const prerender = true;

/**
 * / – Home page (English)
 * Consume contenido dinámico desde WordPress GraphQL
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@components/landing/Hero.astro";
import Method from "@components/landing/Method.astro";
import OurArchitecture from "@components/landing/OurArchitecture.astro";
import TheTeam from "@components/landing/TheTeam.astro";
import WorkPreview from "@components/landing/WorkPreview.astro";
import HomeContact from "@components/landing/HomeContact.astro";
import { getWPHomePage } from "@lib/wordpress";

const wpHome = await getWPHomePage();
---

<BaseLayout
	wpPost={wpHome}
	fallbackTitle="Go Estrategia Creativa – Creative Agency"
	fallbackDescription="We transform brands through creative strategy, digital design and compelling content."
	pageSlug="">
	<Hero />
	<Method />
	<WorkPreview class="pt-24 lg:pt-32 pb-12 lg:pb-16" />
	<OurArchitecture />
	<TheTeam />
	<HomeContact />
</BaseLayout>
