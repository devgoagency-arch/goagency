---
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import Articles from "@components/blog/Articles.astro";
import { getWPPage } from "@lib/wordpress";

let wpPage = null;
const wpUrl = import.meta.env.WORDPRESS_API_URL;
if (wpUrl && !wpUrl.includes("tu-wordpress.com")) {
	try {
		wpPage = await getWPPage("blog", "en");
	} catch {}
}
---

<BaseLayout
	wpPost={wpPage}
	fallbackTitle="Blog – Go Estrategia Creativa"
	fallbackDescription="Insights on creative strategy, branding and digital marketing."
	pageSlug="blog">
	<Articles />
</BaseLayout>
