---
import { Image } from "astro:assets";
import logoSrc from "@assets/images/global/logoFull.svg";
import { Icon } from "astro-icon/components";
import { getLangFromUrl, getUrlWithoutLang, useTranslations, useTranslatedPath } from "@i18n/utils";

const isDev = import.meta.env.DEV;

const lang = getLangFromUrl(Astro.url);
const path = getUrlWithoutLang(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

let pages = [
	{
		title: "Home",
		url: "/",
	},
	{
		title: t("projects"),
		url: "/proyectos/",
	},
	{
		title: "About",
		url: "/#team",
	},
	{
		title: t("contacts"),
		url: "/#contact",
	},
];

// if (isDev) {
// 	pages.push({
// 		title: "Overview",
// 		url: "/system/overview",
// 	});
// }

const { pathname } = Astro.url;
---

<!-- Dynamic Header Backdrop -->
<div id="header-backdrop" class="fixed top-0 left-0 w-full h-[4.5rem] md:h-[5.9rem] z-40 backdrop-blur-md bg-black/5 transition-colors duration-500 pointer-events-none"></div>

<header>
	<a href={translatePath("/")} aria-label="Home" class="logo fixed z-50 flex h-[4.5rem] items-center md:h-[5.9rem]">
		<Image src={logoSrc} alt="Logo" class="logo-img h-7 w-auto md:h-9" loading="eager" />
	</a>
</header>
<div data-xdata="{ open: false }" class="navigation fixed right-0 top-0 z-50" data-xbind.class="{'w-full navbar-open': open}">
	<div class="ml-auto md:max-w-fit" data-xbind.class="{'max-w-3xl': open, 'max-w-[8rem]': !open }">
		<div class="mx-auto w-full">
			<div
				class="shadow-thick resizable nav-container squircle relative mx-auto flex w-full flex-col justify-center overflow-x-hidden backdrop-blur-xl backdrop-filter md:flex-row-reverse"
				style="background-color: #dff4f0;">
				<!-- Desktop Hamburger Button (Visible only when collapsed) -->
				<div class="desktop-hamburger hidden md:flex absolute inset-0 items-center justify-center cursor-pointer opacity-0 pointer-events-none transition-opacity duration-300">
					<svg class="h-6 w-6 text-zinc-800" stroke="currentColor" fill="none" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
				</div>
				<div class="flex flex-row items-center justify-end md:hidden">
					<a class="px-3 py-[0.4rem] pl-4" href={translatePath("/#contact")} aria-label="Contact Page">
						<Icon class="text-white" name="octicon:mail-16" width="20" data-xbind.class="{'hidden': open}" />
					</a>
					<button
						data-xon.click="open = !open"
						data-xbind.style="{'padding-top': open ? '1rem' : '0.4rem'}"
						aria-label="Open navbar"
						class="inline-flex items-center justify-center px-3 py-[0.4rem] pr-4 text-white hover:text-blue-300 focus:text-white focus:outline-none">
						<svg class="h-6 w-6" stroke="currentColor" fill="none" viewBox="0 0 24 24">
							<path
								data-xbind.class="{'hidden': open, 'inline-flex': !open }"
								class="inline-flex"
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M4 6h16M4 12h16M4 18h16">
							</path>
							<path
								data-xbind.class="{'hidden': !open, 'inline-flex': open }"
								class="hidden"
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M6 18L18 6M6 6l12 12">
							</path>
						</svg>
					</button>
				</div>
				<nav data-xbind.class="{'flex': open, 'hidden': !open}" class="hidden flex-grow flex-col justify-center py-12 md:flex md:py-0">
					<ul
						class="flex list-none flex-col items-end justify-center gap-2 px-2 text-center text-3xl md:flex-row md:items-center md:text-base">
						{
							pages.map((page) => (
								<li data-cursor-hover>
									<a
										href={translatePath(page.url)}
										class={`inline-block cursor-pointer px-1 py-[0.33rem] ${
											page.url === pathname ||
											page.url === pathname.replace(/^\/es|\/$/, "") ||
											(page.url === "/blog/" && (pathname.startsWith("/blog") || pathname.startsWith("/es/blog")))
												? "active"
												: ""
										}`}>
										<span class="menu-item-container inline-block">
											<span class="menu-item px-4 py-1 font-semibold uppercase tracking-wide text-zinc-400 hover:text-white focus:text-white focus:shadow-none focus:outline-none">
												{page.title}
											</span>
										</span>
									</a>
								</li>
							))
						}

					</ul>
				</nav>
			</div>
		</div>
	</div>
</div>

<style>
	.navigation {
		/* mix-blend-mode eliminado — causaba inversión de colores */
	}
	.navigation.navbar-open {
		/* sin blend mode */
	}
	.navigation {
		padding: 1rem var(--base-padding-x);
	}
	.logo {
		position: fixed;
		left: 0;
		top: 0;
		z-index: 50;
		padding: 1rem var(--base-padding-x);
		pointer-events: auto;
	}
	.logo-img {
		transition: filter 0.3s ease;
	}
	.logo.logo-white .logo-img {
		filter: brightness(0) invert(1);
	}
	@media (min-width: 768px) {
		.navigation {
			padding: 2rem var(--base-padding-x);
		}
		.logo {
			padding: 2rem var(--base-padding-x);
		}
	}
	.resizable:before {
		content: "|";
		position: absolute;
		left: 0.4rem;
		top: 0.36rem;
		font-size: 12px;
		line-height: 23px;
		color: #45ccaa;
		opacity: 0;
		text-shadow: 4px 0 #45ccaa;
		transition: all 0.5s ease;
	}
	.collapsed .resizable:before {
		opacity: 1;
	}
	nav a .menu-item-container {
		border-radius: 0.45rem;
		transition: background-color 0.25s ease;
	}
	/* Textos base: oscuros y legibles sobre fondo claro */
	nav a .menu-item {
		color: #1a1a1a !important;
	}
	/* HOVER → Primary con texto blanco */
	nav ul:not(.collapsed) a:hover .menu-item-container {
		background: #45ccaa !important;
	}
	nav ul:not(.collapsed) a:hover .menu-item-container .menu-item {
		color: #ffffff !important;
	}
	/* ACTIVE (página actual) → Primary permanente con texto blanco */
	nav ul:not(.collapsed) a.active .menu-item-container {
		background: #45ccaa !important;
		transition-duration: 0.3s;
	}
	nav ul:not(.collapsed) a.active .menu-item-container .menu-item {
		color: #ffffff !important;
	}
	/* Colapsado */
	nav ul.collapsed a.active .menu-item-container .menu-item,
	nav ul.collapsed a:hover .menu-item-container .menu-item {
		color: #ffffff;
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { DrawSVGPlugin } from "gsap/DrawSVGPlugin";

	gsap.registerPlugin(DrawSVGPlugin, ScrollTrigger);

	function init() {
		gsap.timeline({
			defaults: {
				duration: 1,
				ease: "power2.out",
			},
		})
			.from(".logo-svg path", { drawSVG: 0 })
			.to(".logo-svg path", { fill: "#000", duration: 2 }, "<+=0.5");

		let isHoveringMenu = false;
		let menuCollapsed = false;

		const pageLinksUl = document.querySelector(".nav-container nav ul");

		if (!pageLinksUl) {
			return;
		}

		let menuCollapseTl = gsap
			.timeline({
				defaults: {
					ease: "power2.inOut",
					duration: 0.35,
				},
				paused: true,
				onStart: () => {
					pageLinksUl.classList.add("collapsed");
				},
				onReverseComplete: () => {
					pageLinksUl.classList.remove("collapsed");
				}
			})
			.to(".nav-container nav", {
				opacity: 0,
				scale: 0.9,
				pointerEvents: "none",
				display: "none",
				duration: 0.15
			})
			.to(".nav-container", {
				width: 56,
				height: 56,
				paddingLeft: 0,
				paddingRight: 0,
				duration: 0.25
			}, "-=0.05")
			.to(".desktop-hamburger", {
				opacity: 1,
				pointerEvents: "auto",
				duration: 0.15
			}, "-=0.1");

		const isTouchDevice = window.matchMedia("(hover: none)").matches;

		if (window.innerWidth >= 768 && !isTouchDevice) {
			function expandMenu() {
				menuCollapseTl.reverse();
				pageLinksUl?.classList.remove("collapsed");
				document.querySelector(".navigation")?.classList.remove("collapsed");
				menuCollapsed = false;
			}

			function collapseMenu() {
				if (window.scrollY > 200) {
					menuCollapseTl.play();
					pageLinksUl?.classList.add("collapsed");
					document.querySelector(".navigation")?.classList.add("collapsed");
					menuCollapsed = true;
				}
			}

			collapseMenu();

			const navContainer = document.querySelector(".nav-container") as HTMLElement;

			function mouseEnterHandler() {
				isHoveringMenu = true;
				expandMenu();
			}

			function mouseLeaveHandler() {
				isHoveringMenu = false;
				collapseMenu();
			}

			function handleScroll() {
				if (window.scrollY > 200 && !isHoveringMenu && !menuCollapsed) {
					collapseMenu();
				} else if (window.scrollY <= 200 && menuCollapsed) {
					expandMenu();
				}
			}

			navContainer?.removeEventListener("mouseenter", mouseEnterHandler);
			navContainer?.addEventListener("mouseenter", mouseEnterHandler);

			navContainer?.removeEventListener("mouseleave", mouseLeaveHandler);
			navContainer?.addEventListener("mouseleave", mouseLeaveHandler);

			window?.removeEventListener("scroll", handleScroll);
			window?.addEventListener("scroll", handleScroll);

			const desktopHam = document.querySelector(".desktop-hamburger");
			if (desktopHam) {
				desktopHam.addEventListener("click", expandMenu);
			}
		}

		// ScrollTrigger to dock the fixed header logo in the footer at the bottom of the page
		const footer = document.querySelector("footer");
		if (footer) {
			gsap.to(".logo", {
				scrollTrigger: {
					trigger: footer,
					start: "top bottom",
					end: "bottom bottom",
					scrub: true,
				},
				y: () => {
					const f = document.querySelector("footer");
					if (!f) return 0;
					return window.innerHeight - f.offsetHeight;
				},
				ease: "none"
			});
		}

		function checkLogoTheme() {
			const logo = document.querySelector(".logo") as HTMLElement;
			const headerBg = document.getElementById("header-backdrop");
			if (!logo) return;
			
			const logoRect = logo.getBoundingClientRect();
			// Compute logo center Y coordinate relative to document scroll
			const logoCenterY = window.scrollY + logoRect.top + logoRect.height / 2;
			
			// Find all block-level elements that act as sections or containers
			const sections = document.querySelectorAll("section, footer, header, div.section, #method");
			let isOverDark = false;
			
			sections.forEach((sec) => {
				const htmlSec = sec as HTMLElement;
				// Get absolute top/bottom offset coordinates of the section relative to the page
				const rect = htmlSec.getBoundingClientRect();
				const top = rect.top + window.scrollY;
				const height = rect.height;
				const bottom = top + height;
				
				if (logoCenterY >= top && logoCenterY <= bottom) {
					const classes = htmlSec.className;
					const id = htmlSec.id;
					
					// Checks for known dark classes / identifiers
					const hasDarkClass = classes.includes("bg-black") || 
					                     classes.includes("bg-zinc-900") || 
					                     classes.includes("bg-[#18181b]") || 
					                     classes.includes("faq-section") || 
					                     classes.includes("tagline-section") || 
					                     id === "method";
					                     
					// Double check using computed background color
					let hasDarkComputed = false;
					const bg = window.getComputedStyle(htmlSec).backgroundColor;
					if (bg && bg !== "rgba(0, 0, 0, 0)" && bg !== "transparent") {
						const match = bg.match(/\d+/g);
						if (match) {
							const r = parseInt(match[0], 10);
							const g = parseInt(match[1], 10);
							const b = parseInt(match[2], 10);
							const luminance = 0.299 * r + 0.587 * g + 0.114 * b;
							if (luminance < 140) {
								hasDarkComputed = true;
							}
						}
					}
					
					if (hasDarkClass || hasDarkComputed) {
						isOverDark = true;
					}
				}
			});
			
			if (isOverDark) {
				logo.classList.add("logo-white");
				if (headerBg) {
					headerBg.classList.remove("bg-black/5");
					headerBg.classList.add("bg-white/10");
				}
			} else {
				logo.classList.remove("logo-white");
				if (headerBg) {
					headerBg.classList.remove("bg-white/10");
					headerBg.classList.add("bg-black/5");
				}
			}
		}

		// Initial check
		checkLogoTheme();
		// Scroll listener for real-time background detection
		window?.addEventListener("scroll", checkLogoTheme, { passive: true });
		// Recalculate on refresh
		ScrollTrigger.addEventListener("refresh", checkLogoTheme);
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", init);
	} else {
		init();
	}

	// Also support Astro's client-side view transition lifecycle
	document.addEventListener("astro:page-load", init);
</script>
