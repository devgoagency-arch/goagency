---
export interface Props {
	targetId?: string;
	color?: string;
	id?: string;
	upTargetId?: string;
	upColor?: string;
}

const { 
	targetId, 
	color = "#e25432", 
	id = "scroll-arrow-" + Math.random().toString(36).substring(7),
	upTargetId,
	upColor = "#18181b"
} = Astro.props;
---

<div class="flex flex-col items-center justify-center w-full mt-10 mb-10 gap-3">
	{upTargetId && (
		<div class="scroll-arrow-wrapper relative flex items-center justify-center w-12 h-12" data-cursor-hover>
			<button
				id={`${id}-up`}
				data-target={upTargetId}
				class="scroll-arrow-btn flex h-8 w-8 items-center justify-center rounded-full text-white focus:outline-none transition-transform duration-100 relative cursor-pointer"
				style={`background-color: ${upColor}; box-shadow: 0 5px 10px -3px ${upColor}59;`}
				aria-label={`Scroll up to ${upTargetId}`}>
				<svg class="h-4 w-4 stroke-white fill-none animate-pulse" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
					<path d="M12 19V5M5 12l7-7 7 7"></path>
				</svg>
			</button>
		</div>
	)}

	{targetId && (
		<div class="scroll-arrow-wrapper relative flex items-center justify-center w-24 h-24" data-cursor-hover>
			<button
				id={id}
				data-target={targetId}
				class="scroll-arrow-btn flex h-16 w-16 items-center justify-center rounded-full text-white focus:outline-none transition-transform duration-100 relative cursor-pointer"
				style={`background-color: ${color}; box-shadow: 0 10px 15px -3px ${color}59;`}
				aria-label={`Scroll down to ${targetId}`}>
				<svg class="h-6 w-6 stroke-white fill-none animate-pulse" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
					<path d="M12 5v14M19 12l-7 7-7-7"></path>
				</svg>
			</button>
		</div>
	)}
</div>

<script>
	import { gsap } from "gsap";
	import { ScrollToPlugin } from "gsap/ScrollToPlugin";

	gsap.registerPlugin(ScrollToPlugin);

	function initScrollArrows() {
		const buttons = document.querySelectorAll(".scroll-arrow-btn");
		
		buttons.forEach((btn) => {
			const button = btn as HTMLButtonElement;
			const targetId = button.getAttribute("data-target");
			const wrapper = button.closest(".scroll-arrow-wrapper");
			
			if (!targetId || !wrapper) return;

			// Idle float
			const floatTween = gsap.to(button, {
				y: 8,
				repeat: -1,
				yoyo: true,
				ease: "sine.inOut",
				duration: 1.6,
				paused: false
			});

			// Click
			button.addEventListener("click", () => {
				gsap.to(window, { duration: 0.8, scrollTo: targetId, ease: "power3.inOut" });
			});

			// Magnetic hover
			let isMagnetic = false;
			const handleMouseMove = (e: MouseEvent) => {
				const rect = wrapper.getBoundingClientRect();
				const centerX = rect.left + rect.width / 2;
				const centerY = rect.top + rect.height / 2;
				
				const distX = e.clientX - centerX;
				const distY = e.clientY - centerY;
				const distance = Math.sqrt(distX * distX + distY * distY);

				if (distance < 100) {
					if (!isMagnetic) {
						isMagnetic = true;
						floatTween.pause();
					}
					const strength = (100 - distance) / 100;
					gsap.to(button, {
						x: distX * strength * 0.45,
						y: distY * strength * 0.45,
						duration: 0.2,
						ease: "power2.out",
						overwrite: "auto"
					});
				} else if (isMagnetic) {
					isMagnetic = false;
					gsap.to(button, {
						x: 0,
						y: 0,
						duration: 0.6,
						ease: "elastic.out(1, 0.3)",
						overwrite: "auto",
						onComplete: () => floatTween.play()
					});
				}
			};

			window.addEventListener("mousemove", handleMouseMove);
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initScrollArrows);
	} else {
		initScrollArrows();
	}
	document.addEventListener("astro:page-load", initScrollArrows);
</script>
