---
import Newsletter from "@components/blog/Newsletter.astro";
import { getLangFromUrl, useTranslatedPath, useTranslations } from "@i18n/utils";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import logoFullSrc from "@assets/images/global/logoFull.svg";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<footer class="section min-h-screen gap-y-10 py-3 lg:gap-y-32">
	<div class="relative flex-grow"></div>
	<div class="relative grid grid-cols-6 gap-y-20 lg:grid-cols-12 lg:text-xl">
		<div class="col-span-6 col-start-1 grid grid-cols-6 gap-6 lg:col-span-8">
			<div class="col-span-2 col-start-4 flex flex-col gap-2 lg:col-span-3">
				<a href="https://twitter.com//" target="_blank">Twitter / X</a>
				<a href="https://www.instagram.com//" target="_blank">Instagram</a>
				<a href="https://www.linkedin.com/" target="_blank">Linkedin</a>
				<a href="https://tiktok.com/" target="_blank">TikTok</a>
			</div>
			<div class="col-span-3 row-start-1 lg:col-span-2 lg:col-start-4 lg:row-start-auto">
				<div class="flex flex-col gap-2">
					<a href={translatePath("/")}>Home</a>
					<a href={translatePath("/blog/")}>Blog</a>
					<a href={translatePath("/tags/")}>Tags</a>
					<a href={translatePath("/contact/")}>{t("contacts")}</a>
					<a href={translatePath("/terms/")}>Terms</a>
					<a href={translatePath("/privacy/")}>Privacy Policy</a>
					<a href={translatePath("/rss.xml")}>RSS</a>
				</div>
			</div>
			<div class="col-span-3 mt-10 lg:col-start-4">
				<div class="relative flex flex-col overflow-hidden"></div>
				<div class="relative mt-1 flex h-8 flex-col overflow-hidden">
					<a href="mailto:test@mintaka.co" class="block cursor-pointer overflow-hidden">test@mintaka.co</a>
				</div>
			</div>
		</div>
		<div class="col-span-6 row-start-1 text-5xl leading-tight lg:col-span-4 lg:row-start-auto lg:text-6xl">
			<!-- Newsletter Section -->
			<div>{t("footer.newsletter")}</div>
			<div>{t("footer.newsletter2")}</div>
			<Newsletter />
		</div>
	</div>

	<!-- Logo: misma posición/tamaño que header — fade-in al entrar el footer al viewport -->
	<a href="/" aria-label="Home" class="footer-logo-link" style="padding: 2rem var(--base-padding-x);">
		<Image src={logoFullSrc} alt="Logo" class="h-7 w-auto md:h-9" loading="lazy" />
	</a>

	<div class="relative mt-4 flex w-full items-end justify-between gap-y-4 text-sm lg:text-xl lg:font-normal">
		<div>©2023 YOUR COMPANY</div>
		<button
			id="go-top-button"
			aria-label="Go to Top"
			class="fill-transparent transition-colors duration-300 hover:fill-black hover:text-white"
			data-cursor-hover
			data-cursor-parallax>
			<svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24">
				<g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="9"></circle><path d="m15 12l-3-3m0 0l-3 3m3-3v6"></path>
				</g>
			</svg>
		</button>
	</div>
</footer>

<style>
	footer {
		@apply relative flex w-full flex-col;
	}

	/* El logo del footer: mismo layout que el header logo (absolute, top-left) */
	.footer-logo-link {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 50;
		display: flex;
		align-items: center;
		/* Oculto inicialmente — GSAP lo animará a opacity 1 */
		opacity: 0;
		transform: translateX(-16px);
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollToPlugin } from "gsap/ScrollToPlugin";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollToPlugin, ScrollTrigger);

	function init() {
		const goTopButton = document.getElementById("go-top-button");
		if (goTopButton) {
			goTopButton.addEventListener("click", function () {
				gsap.to(window, { duration: 0.5, scrollTo: 0 });
			});
		}

		// Fade-in del logo: se activa cuando el footer entra al viewport
		const footerLogo = document.querySelector(".footer-logo-link") as HTMLElement;
		if (footerLogo) {
			// Forzar estado inicial via GSAP (evita conflictos con CSS global)
			gsap.set(footerLogo, { opacity: 0, x: -20 });

			ScrollTrigger.create({
				trigger: "footer",
				start: "top 70%",
				onEnter: () => {
					gsap.to(footerLogo, {
						opacity: 1,
						x: 0,
						duration: 0.9,
						ease: "power3.out",
					});
				},
				once: true,
			});
		}
	}

	document.removeEventListener("DOMContentLoaded", init);
	document.addEventListener("DOMContentLoaded", init);
</script>
