---
import Newsletter from "@components/blog/Newsletter.astro";
import { getLangFromUrl, useTranslatedPath, useTranslations } from "@i18n/utils";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import logoFullSrc from "@assets/images/global/logoFull.svg";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<footer class="section relative bg-[#18181b] text-zinc-300 py-16 lg:py-24 border-t border-zinc-800">
	<div class="mx-auto max-w-[90rem] px-4 md:px-8 w-full">
		<div class="grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-8 text-center md:text-left justify-items-center md:justify-items-stretch">
			
			<!-- Column 1: Navigation -->
			<div class="flex flex-col gap-4 text-lg">
				<h3 class="font-display text-xl text-white mb-2 tracking-widest uppercase text-xs">Navigation</h3>
				<a href={translatePath("/")} class="hover:text-[#45ccaa] transition-colors">Home</a>
				<a href={translatePath("/proyectos/")} class="hover:text-[#45ccaa] transition-colors">Projects</a>
				<a href="/#team" class="hover:text-[#45ccaa] transition-colors">About</a>
				<a href="/#contact" class="hover:text-[#45ccaa] transition-colors">Contact</a>
				<button onclick="document.getElementById('terms-modal').classList.remove('hidden')" class="hover:text-[#45ccaa] transition-colors text-left md:text-left text-center">Terms of Service</button>
				<button onclick="document.getElementById('privacy-modal').classList.remove('hidden')" class="hover:text-[#45ccaa] transition-colors text-left md:text-left text-center">Privacy Policy</button>
			</div>

			<!-- Column 2: Contact -->
			<div class="flex flex-col gap-4 text-lg">
				<h3 class="font-display text-xl text-white mb-2 tracking-widest uppercase text-xs">Contact Us</h3>
				<a href="https://www.linkedin.com/company/go-estrategia-creativa/" target="_blank" rel="noopener noreferrer" class="hover:text-[#45ccaa] transition-colors">LinkedIn</a>
				<a href="mailto:hello@goestrategiacreativa.com" class="hover:text-[#45ccaa] transition-colors">hello@goestrategiacreativa.com</a>
				<a href="https://wa.me/573164515556" target="_blank" rel="noopener noreferrer" class="hover:text-[#45ccaa] transition-colors">WhatsApp: +57 316 451 5556</a>
			</div>
			
		</div>

		<!-- Bottom Row -->
		<div class="mt-20 pt-8 border-t border-zinc-800 flex flex-col md:flex-row items-center justify-between gap-6 text-sm text-zinc-500">
			<div class="text-center md:text-left">©2026 Go Agency — Go Marketing y Eventos SAS</div>
			<button
				id="go-top-button"
				aria-label="Go to Top"
				class="text-zinc-500 hover:text-[#45ccaa] transition-colors duration-300 md:fixed md:bottom-24 md:right-8 md:z-50 md:bg-[#18181b] md:rounded-full md:shadow-lg"
				data-cursor-hover>
				<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" class="fill-transparent">
					<g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5">
						<circle cx="12" cy="12" r="9"></circle><path d="m15 12l-3-3m0 0l-3 3m3-3v6"></path>
					</g>
				</svg>
			</button>
		</div>
	</div>
</footer>

<style>
	footer {
		@apply relative flex w-full flex-col;
	}

</style>

<script>
	import { gsap } from "gsap";
	import { ScrollToPlugin } from "gsap/ScrollToPlugin";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollToPlugin, ScrollTrigger);

	function init() {
		const goTopButton = document.getElementById("go-top-button");
		if (goTopButton) {
			goTopButton.addEventListener("click", function () {
				gsap.to(window, { duration: 0.5, scrollTo: 0 });
			});
		}

	}

	document.removeEventListener("DOMContentLoaded", init);
	document.addEventListener("DOMContentLoaded", init);
</script>
