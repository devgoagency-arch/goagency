---
---

<div id="cookie-banner" class="fixed bottom-0 left-0 right-0 z-50 bg-zinc-900 border-t border-zinc-800 p-4 md:p-6 shadow-2xl translate-y-full transition-transform duration-500 flex flex-col md:flex-row items-center justify-between gap-4">
	<div class="text-zinc-300 text-sm md:text-base font-light max-w-4xl">
		We use cookies to analyze traffic and improve user experience. You may accept or decline non-essential cookies. Declining will not affect your ability to use the website. See our <button onclick="document.getElementById('privacy-modal').classList.remove('hidden')" class="text-[#45ccaa] hover:underline">Privacy Policy</button> for more details.
	</div>
	<div class="flex items-center gap-3 w-full md:w-auto shrink-0">
		<button id="decline-cookies" class="flex-1 md:flex-none px-6 py-2.5 rounded-lg border border-zinc-700 text-zinc-300 hover:bg-zinc-800 transition-colors text-sm font-semibold uppercase tracking-widest">
			Decline
		</button>
		<button id="accept-cookies" class="flex-1 md:flex-none px-6 py-2.5 rounded-lg bg-[#45ccaa] hover:bg-[#3ab899] text-white transition-colors text-sm font-semibold uppercase tracking-widest">
			Accept
		</button>
	</div>
</div>

<script>
	function initCookieBanner() {
		const banner = document.getElementById('cookie-banner');
		const acceptBtn = document.getElementById('accept-cookies');
		const declineBtn = document.getElementById('decline-cookies');

		if (!banner || !acceptBtn || !declineBtn) return;

		// Check local storage
		const cookieConsent = localStorage.getItem('go_cookie_consent');
		
		if (!cookieConsent) {
			// Show banner
			setTimeout(() => {
				banner.classList.remove('translate-y-full');
			}, 1000);
		}

		function hideBanner(choice) {
			localStorage.setItem('go_cookie_consent', choice);
			banner?.classList.add('translate-y-full');
			if (choice === 'accepted') {
				document.dispatchEvent(new CustomEvent('cookies-accepted'));
			}
		}

		acceptBtn.addEventListener('click', () => hideBanner('accepted'));
		declineBtn.addEventListener('click', () => hideBanner('declined'));
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initCookieBanner);
	} else {
		initCookieBanner();
	}

	document.addEventListener('astro:page-load', initCookieBanner);
</script>
