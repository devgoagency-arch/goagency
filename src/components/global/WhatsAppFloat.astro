			</svg>
		</div>
		
		<!-- Text Container -->
		<div class="relative flex items-center h-6 w-[170px]">
			<span class="wa-text-default absolute left-0 whitespace-nowrap font-['Montserrat'] font-light text-white text-sm transition-opacity duration-300 opacity-100">
				Hi, do you want to talk?
			</span>
			<span class="wa-text-hover absolute left-0 whitespace-nowrap font-['Montserrat'] font-bold text-[#45ccaa] text-sm transition-opacity duration-300 opacity-0">
				Let's start &rarr;
			</span>
		</div>
	</a>
</div>

<style>
	/* Hover Effects */
	#whatsapp-float:hover .whatsapp-btn {
		transform: scale(1.05);
	}

	#whatsapp-float:hover .wa-text-default {
		opacity: 0;
	}

	#whatsapp-float:hover .wa-text-hover {
		opacity: 1;
	}

	/* Override inline classes when forcing show via JS */
	#whatsapp-float.force-show {
		transform: translateY(0) !important;
	}
</style>

<script>
	function initWhatsApp() {
		const waFloat = document.getElementById('whatsapp-float');
		if (!waFloat) return;

		let isHovered = false;

		// Track hover state
		waFloat.addEventListener('mouseenter', () => isHovered = true);
		waFloat.addEventListener('mouseleave', () => {
			isHovered = false;
			// Remove force-show if mouse leaves while it was popping up
			waFloat.classList.remove('force-show');
		});

		// Every 15 seconds
		setInterval(() => {
			if (!isHovered) {
				waFloat.classList.add('force-show'); // Pop up fully
				
				// Stay for 2 seconds then go back to peek
				setTimeout(() => {
					if (!isHovered) {
						waFloat.classList.remove('force-show');
					}
				}, 2000);
			}
		}, 15000);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initWhatsApp);
	} else {
		initWhatsApp();
	}

	document.addEventListener('astro:page-load', initWhatsApp);
</script>
