---
interface Stat {
  number: string;
  label: string;
}

interface Props {
  stats: Stat[];
  note?: string;
}

const { stats = [], note } = Astro.props;
---

<div class="results-block p-8 sm:p-10 my-10 bg-white/70 backdrop-blur-md shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-stone-200/50">
  
  <div class="flex flex-col divide-y divide-stone-200/80">
    {stats.map((stat) => (
      <div class="stat-item flex flex-col gap-2 py-6 first:pt-0 last:pb-0 w-full">
        <span class="stat-number font-display text-3xl sm:text-4xl font-light tracking-tight text-[#45ccaa] whitespace-nowrap">
          {stat.number}
        </span>
        <span class="stat-label font-sans text-[10px] sm:text-xs font-normal text-stone-500 uppercase tracking-wide">
          {stat.label}
        </span>
      </div>
    ))}
  </div>

  {note && (
    <div class="note-container mt-6 pt-6 border-t border-stone-200/80">
      <p class="font-sans text-[11px] sm:text-xs font-light text-stone-500 leading-relaxed italic">
        {note}
      </p>
    </div>
  )}
</div>

<style>
  .results-block {
    border-radius: 10px;
  }
  
  /* Mantenemos solo la asignación de familia tipográfica. */
  /* Los pesos (!important) fueron eliminados para dejar que Tailwind controle la UI. */
  .stat-label, .note-container p {
    font-family: "Montserrat", sans-serif;
  }
</style>