---
import LinkBlend from "@components/global/LinkBlend.astro";
import ScrollArrow from "@components/global/ScrollArrow.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<section id="hero" class="section home-dark-section hero min-h-screen">
	<div class="mx-auto flex h-full flex-col py-4 lg:py-10">
		<div class="relative flex flex-1 flex-col justify-center rounded-lg pb-10 pt-20 lg:rounded-2xl gap-8">
			<div class="flex flex-col items-center justify-center gap-4">
				<span class="flex items-center gap-3 md:gap-4 text-xs md:text-sm font-medium uppercase tracking-[0.3em] text-zinc-500">
					<span>STRATEGY-LED</span>
					<img src="/images/GO-Agency-AI.png" alt="AI Core" class="ai-spin-icon w-6 h-6 md:w-8 md:h-8 object-contain drop-shadow-[0_0_8px_rgba(69,204,170,0.6)]" />
					<span>AI-ACCELERATED</span>
				</span>
				<h1 class="text-center font-display text-4xl sm:text-5xl md:text-6xl lg:text-[5.25rem] leading-[1.1] tracking-tight">
					<span class="block font-normal not-italic normal-case">{lang === 'es' ? 'Primero diagnosticamos.' : 'We diagnose first.'}</span>
					<span class="block font-normal italic normal-case">{lang === 'es' ? 'Luego construimos.' : 'Then we build.'}</span>
				</h1>
			</div>
			
			<div class="flex flex-col items-center gap-6 text-center lg:gap-10">
				<p class="mt-4 max-w-3xl font-display text-lg font-light text-zinc-400 sm:text-2xl md:text-3xl">
					{lang === 'es' ? 'Marca, estrategia, productos digitales y comunicaciones.' : 'Brand, strategy, digital products and communications.'}
				</p>
				
				<ScrollArrow targetId="#method" color="#e25432" id="hero-arrow" />
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		padding-bottom: 0;
		position: relative;
		border-radius: inherit;
		overflow: hidden;
	}
	.hero > div {
		grid-column: 1 / span 12;
	}
	.ai-spin-icon {
		will-change: transform;
	}
</style>

<script>
	import { gsap } from "gsap";

	function initHero() {
		const icon = document.querySelector(".ai-spin-icon");
		if (!icon) return;

		// Entrada inicial: cae desde arriba girando rápido
		gsap.from(icon, {
			y: -150,
			rotation: -1080,
			opacity: 0,
			duration: 2,
			ease: "power3.out",
			onComplete: () => {
				// Loop infinito simulando procesamiento de AI
				// Empieza lento, acelera muchísimo, frena hasta detenerse, y repite.
				gsap.to(icon, {
					rotation: "+=1440", // 4 vueltas completas
					duration: 3,
					ease: "power4.inOut",
					repeat: -1,
					repeatDelay: 0.8 // Pausa antes de la siguiente "solicitud"
				});
			}
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initHero);
	} else {
		initHero();
	}
	document.addEventListener("astro:page-load", initHero);
</script>
