---
import ScrollArrow from "@components/global/ScrollArrow.astro";
---

<section id="team" class="w-full bg-slate-100 text-stone-900 pt-12 lg:pt-16 pb-12 lg:pb-16 relative">
	<div class="mx-auto max-w-7xl px-4 md:px-8">
		
		<!-- Header -->
		<div class="mb-16 lg:mb-24 flex flex-col items-center text-center gap-4">
			<span class="text-xs uppercase tracking-[0.2em] text-zinc-500 font-mono">The Team</span>
			<h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.1] tracking-tight text-black max-w-4xl">
				Two directors. No account managers in between.
			</h2>
		</div>

		<!-- Team Grid -->
		<div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20">
			
			<!-- Person 1: Alejandra Muguerza -->
			<div class="flex flex-col gap-6">
				<div class="w-[60%] mx-auto aspect-[4/5] bg-zinc-300 rounded-[10px] overflow-hidden relative shadow-[0_8px_30px_rgba(0,0,0,0.04)]">
					<img src="/img/alejandra.jpg" alt="Alejandra Muguerza" class="w-full h-full object-cover" />
				</div>
				<div class="flex flex-col gap-2 items-center text-center">
					<h3 class="font-['Midnight'] text-3xl md:text-4xl text-black">
						Alejandra Muguerza
					</h3>
					<span class="font-['Montserrat'] font-bold text-xs md:text-sm uppercase tracking-widest text-[#45ccaa]">
						Accounts, Consulting & Strategy Director
					</span>
				</div>
				<p class="font-['Montserrat'] font-light text-zinc-600 text-lg leading-relaxed text-center">
					Alejandra is the person in the room who asks the question nobody else thought to ask. She has built brand and communication strategies for oil companies managing territorial conflict, retailers scaling digitally, and corporations navigating change. She connects what a business needs to say with what its audiences actually need to hear.
				</p>
				<div class="mt-4 flex justify-center">
					<a 
						href="https://www.linkedin.com/in/alejandramuguerza-brand-marketing-communications/" 
						target="_blank" 
						rel="noopener noreferrer"
						class="inline-flex items-center justify-center bg-[#45ccaa] text-white px-8 py-3 rounded-xl font-bold transition-all hover:bg-[#2ea888] shadow-md hover:shadow-lg"
					>
						Connect on LinkedIn
					</a>
				</div>
			</div>

			<!-- Person 2: Nestor Espinal -->
			<div class="flex flex-col gap-6">
				<div class="w-[60%] mx-auto aspect-[4/5] bg-zinc-300 rounded-[10px] overflow-hidden relative shadow-[0_8px_30px_rgba(0,0,0,0.04)]">
					<img src="/img/nestor.jpg" alt="Nestor Espinal" class="w-full h-full object-cover" />
				</div>
				<div class="flex flex-col gap-2 items-center text-center">
					<h3 class="font-['Midnight'] text-3xl md:text-4xl text-black">
						Nestor Espinal
					</h3>
					<span class="font-['Montserrat'] font-bold text-xs md:text-sm uppercase tracking-widest text-[#45ccaa]">
						Creative & Development Director
					</span>
				</div>
				<p class="font-['Montserrat'] font-light text-zinc-600 text-lg leading-relaxed text-center">
					Nestor thinks in systems. He sees a website request and diagnoses a brand problem. He sees a photo production budget and finds an AI workflow. Twenty-five years of building visual and digital infrastructure for companies that can't afford to get it wrong — and now, with AI as the engine, he builds it faster.
				</p>
				<div class="mt-4 flex justify-center">
					<a 
						href="https://www.linkedin.com/in/nestorespinal/" 
						target="_blank" 
						rel="noopener noreferrer"
						class="inline-flex items-center justify-center bg-[#45ccaa] text-white px-8 py-3 rounded-xl font-bold transition-all hover:bg-[#2ea888] shadow-md hover:shadow-lg"
					>
						Connect on LinkedIn
					</a>
				</div>
			</div>

		</div>

		<div class="flex justify-center mt-12 lg:mt-20">
			<ScrollArrow targetId="#contact" upTargetId="#architecture" upColor="#45ccaa" color="#e25432" id="team-arrow" />
		</div>
	</div>
</section>
