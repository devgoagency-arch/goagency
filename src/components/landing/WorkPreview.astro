---
/**
 * WorkPreview – Home Section
 * Trae los últimos 6 proyectos publicados en WP CPT "proyectos"
 * y los muestra con el layout masonry + animaciones GSAP.
 */
import WokCard from "@components/work/WokCard.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";
import { getWPProyectos, getImageUrl, getImageAlt, getProjectExcerpt, decodeWPHtml } from "@lib/wordpress";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const { class: className } = Astro.props;

// Trae hasta 6 proyectos de WordPress (los más recientes primero)
let wpProjects: any[] = [];
try {
	wpProjects = await getWPProyectos(6);
} catch {}
---

<section id="projects" class:list={["section work-preview-section home-dark-section py-12", className]}>
	<div class="col-span-12 col-start-1 mx-auto max-w-7xl">
		<h2 class="sr-only">{t("projects")}</h2>

		{
			wpProjects.length > 0 ? (
				<ol class="grid grid-cols-1 gap-24 md:grid-cols-2 lg:gap-44">
					{wpProjects.map((project, index) => {
						const imageUrl = getImageUrl(project);
						const title = decodeWPHtml(project.title ?? "");
						const description = getProjectExcerpt(project);
						const slug = project.slug;

						// Objeto de imagen compatible con WokCard (acepta string o ImageMetadata)
						// WokCard usa <Image> si recibe un objeto con src, o <img> si recibe string
						return (
							<WokCard
								imageUrl={imageUrl}
								project={title}
								link={`/proyectos/${slug}`}
								description={description}
								class={
									index % 2 === 0
										? `md:col-start-1 md:row-start-${Math.floor(index / 2) * 2 + 1} md:row-span-2`
										: `md:col-start-2 md:row-start-${Math.floor(index / 2) * 2 + 2} md:row-span-2`
								}
							/>
						);
					})}
				</ol>
			) : (
				<p class="py-12 text-center text-stone-400">No hay proyectos publicados aún.</p>
			)
		}

		{/* CTA → /proyectos */}
		{
			wpProjects.length > 0 && (
				<div class="mt-20 flex justify-center">
					<a
						href={translatePath("/proyectos")}
						class="inline-flex items-center gap-2 rounded-full border border-current px-8 py-3 text-sm font-semibold uppercase tracking-widest transition-colors hover:border-[#45ccaa] hover:bg-[#45ccaa] hover:text-white">
						{t("projects.all")} →
					</a>
				</div>
			)
		}
	</div>
</section>

<style is:global>
	.work-preview-section ol li img {
		--clip: 0%;
		clip-path: inset(var(--clip) round 0.5rem);
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	function init() {
		const projects = gsap.utils.toArray(".work-preview-section ol li") as gsap.DOMTarget[];
		const previews = gsap.utils.toArray(".work-preview-section ol li img") as gsap.DOMTarget[];
		previews.forEach((preview) => {
			gsap.from(preview, {
				scrollTrigger: {
					trigger: preview,
					start: "top bottom",
					end: "center center",
					scrub: 1,
					markers: false,
				},
				ease: "power3.out",
				"--clip": "30%",
			});
		});

		gsap.to(".home-dark-section", {
			scrollTrigger: {
				trigger: ".work-preview-section",
				start: "bottom bottom",
				end: "bottom 70%",
				scrub: 0.5,
				markers: false,
				immediateRender: false,
			},
			ease: "none",
			backgroundColor: "#18181b",
			color: "#fff",
		});

		if (window.innerWidth >= 768) {
			projects.forEach((project) => {
				gsap.to(project, {
					scrollTrigger: {
						trigger: ".work-preview-section ol",
						start: "top bottom",
						end: "bottom center",
						scrub: 1,
						markers: false,
					},
					ease: "none",
					y: `-200px`,
				});
			});
		}
	}

	document.removeEventListener("DOMContentLoaded", init);
	document.addEventListener("DOMContentLoaded", init);
</script>
