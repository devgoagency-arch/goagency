---
/**
 * WorkPreview – Home Section
 * Trae los últimos 6 proyectos publicados en WP CPT "proyectos"
 * y los muestra con el layout masonry + animaciones GSAP.
 */
import WokCard from "@components/work/WokCard.astro";
import ScrollArrow from "@components/global/ScrollArrow.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";
import { getWPProyectos, getImageUrl, getImageAlt, getProjectExcerpt, getProjectChallenge, getProjectResult, getProjectPillars, decodeWPHtml } from "@lib/wordpress";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const { class: className } = Astro.props;

// Trae hasta 5 proyectos de WordPress (los más recientes primero)
let wpProjects: any[] = [];
try {
	wpProjects = await getWPProyectos(5);
} catch {}
---

<section id="projects" class:list={["section work-preview-section home-dark-section", className]}>
	<div class="col-span-12 col-start-1 mx-auto max-w-7xl px-4 md:px-8">
		<!-- Section Label -->
		<div class="mb-12 lg:mb-20 text-center flex justify-center">
			<h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.1] tracking-tight text-current">Selected Work</h2>
		</div>

		<div class="hidden">
		md:col-start-1 md:col-start-2 md:row-span-2
		md:row-start-1 md:row-start-2 md:row-start-3 md:row-start-4 md:row-start-5 
		md:row-start-6 md:row-start-7 md:row-start-8 md:row-start-9 md:row-start-10
		md:row-start-11 md:row-start-12 md:row-start-13 md:row-start-14 md:row-start-15
		md:row-start-16 md:row-start-17 md:row-start-18 md:row-start-19 md:row-start-20
		md:row-start-21 md:row-start-22 md:row-start-23 md:row-start-24 md:row-start-25
		md:row-start-26 md:row-start-27 md:row-start-28 md:row-start-29 md:row-start-30
		md:row-start-31 md:row-start-32 md:row-start-33 md:row-start-34 md:row-start-35
		md:row-start-36 md:row-start-37 md:row-start-38 md:row-start-39 md:row-start-40
		md:row-start-41 md:row-start-42 md:row-start-43 md:row-start-44 md:row-start-45
		md:row-start-46 md:row-start-47 md:row-start-48 md:row-start-49 md:row-start-50
		</div>
		{
			wpProjects.length > 0 ? (
				<ol class="grid grid-cols-1 gap-24 md:grid-cols-2 lg:gap-44">
					{
						wpProjects.map((project, index) => {
							const imageUrl = getImageUrl(project);
							const title = decodeWPHtml(project.title ?? "");
							const description = getProjectExcerpt(project);
							const challenge = getProjectChallenge(project);
							const result = getProjectResult(project);
							const pillars = getProjectPillars(project);
							const slug = project.id;

							return (
								<WokCard
									imageUrl={imageUrl}
									project={title}
									link={`/proyectos/${slug}`}
									description={description}
									challenge={challenge}
									result={result}
									pillars={pillars}
									content={project.content}
									class={
										index % 2 === 0
											? `md:col-start-1 md:row-start-${Math.floor(index / 2) * 2 + 1} md:row-span-2`
											: `md:col-start-2 md:row-start-${Math.floor(index / 2) * 2 + 2} md:row-span-2`
									}
								/>
							);
						})
					}
				</ol>
			) : (
				<p class="py-12 text-center text-stone-400">No hay proyectos publicados aún.</p>
			)
		}

		{/* CTA → /proyectos */}
		{
			wpProjects.length > 0 && (
				<div class="mt-[var(--base-padding-y)] flex justify-center">
					<a
						href={translatePath("/proyectos")}
						class="inline-flex items-center gap-2 rounded-full border border-current px-8 py-3 text-sm font-semibold uppercase tracking-widest transition-colors hover:border-[#45ccaa] hover:bg-[#45ccaa] hover:text-white">
						{t("projects.all")} →
					</a>
				</div>
			)
		}

		<ScrollArrow targetId="#architecture" upTargetId="#method" upColor="#45ccaa" color="#EDB74D" id="work-arrow" />
	</div>
</section>

<style is:global>
	.work-preview-section ol li img {
		--clip: 0%;
		clip-path: inset(var(--clip) round 0.5rem);
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	function init() {
		const projects = gsap.utils.toArray(".work-preview-section ol li") as gsap.DOMTarget[];
		const previews = gsap.utils.toArray(".work-preview-section ol li img") as gsap.DOMTarget[];
		previews.forEach((preview) => {
			gsap.from(preview, {
				scrollTrigger: {
					trigger: preview,
					start: "top bottom",
					end: "center center",
					scrub: 1,
					markers: false,
				},
				ease: "power3.out",
				"--clip": "30%",
			});
		});

		gsap.to(".home-dark-section", {
			scrollTrigger: {
				trigger: ".work-preview-section",
				start: "bottom bottom",
				end: "bottom 70%",
				scrub: 0.5,
				markers: false,
				immediateRender: false,
			},
			ease: "none",
			backgroundColor: "#18181b",
			color: "#fff",
		});

		if (window.innerWidth >= 768) {
			projects.forEach((project) => {
				gsap.to(project, {
					scrollTrigger: {
						trigger: ".work-preview-section ol",
						start: "top bottom",
						end: "bottom center",
						scrub: 1,
						markers: false,
					},
					ease: "none",
					y: `-200px`,
				});
			});
		}
	}

	document.removeEventListener("DOMContentLoaded", init);
	document.addEventListener("DOMContentLoaded", init);
</script>
