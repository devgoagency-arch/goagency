---
import BlobCursorFollower from "@/components/global/BlobCursorFollower.astro";
import { AstroSeo, type AstroSeoProps } from "@astrolib/seo";
import BaseHead from "@components/BaseHead.astro";
import BackgroundTexture from "@components/global/BackgroundTexture.astro";
import Footer from "@components/global/Footer.astro";
import Navigation from "@components/global/Navigation.astro";
import LegalModals from "@components/global/LegalModals.astro";
import CookieBanner from "@components/global/CookieBanner.astro";
import WhatsAppFloat from "@components/global/WhatsAppFloat.astro";
import RankMathSeo from "@components/seo/RankMathSeo.astro";
import { getLangFromUrl, getHreflangLinks } from "@i18n/utils";
import type { WPPost } from "@lib/wordpress";

const { pathname } = Astro.url;
const lang = getLangFromUrl(Astro.url);
const siteUrl = Astro.site?.toString() ?? "https://goagency.com";

type Props = {
	/** (Nuevo) Post/página de WP con metadatos RankMath embebidos */
	wpPost?: WPPost | null;
	/** (Legado) Props de AstroSeo directas – para páginas existentes */
	seo?: AstroSeoProps;
	/** SEO fallback si no hay wpPost ni seo */
	fallbackTitle?: string;
	fallbackDescription?: string;
	/** Slug de la página para hreflang (sin prefijo de idioma) */
	pageSlug?: string;
	/** Color del blob del cursor (opcional) */
	cursorColor?: string;
	/** Props opcionales para el WhatsAppFloat */
	waPhone?: string;
	waDefaultText?: string;
	waHoverText?: string;
	waMessage?: string;
};

const {
	wpPost = null,
	seo: legacySeo,
	fallbackTitle = "Go Estrategia Creativa – Agencia Creativa",
	fallbackDescription = "Transformamos marcas a través de estrategia creativa, diseño digital y contenido de impacto.",
	pageSlug = "",
	cursorColor,
	waPhone,
	waDefaultText,
	waHoverText,
	waMessage,
} = Astro.props;

// Hreflang para multiidioma
const hreflangLinks = pageSlug ? getHreflangLinks(pageSlug, siteUrl) : [];

// Si viene prop `seo` legacy y no hay wpPost → modo legado (páginas existentes)
const useLegacySeo = !!legacySeo && !wpPost;

function cursorFollowerActive() {
	const activePaths = [
		"/",
		"/es/",
		"/es",
		"/contact",
		"/contact/",
		"/contacto",
		"/contacto/",
		"/es/contacto",
		"/es/contacto/",
		"/about",
		"/about/",
		"/nosotros",
		"/nosotros/",
		"/es/nosotros",
		"/es/nosotros/",
	];
	return (
		activePaths.includes(pathname) ||
		pathname.startsWith("/proyectos") ||
		pathname.startsWith("/blog") ||
		pathname.startsWith("/es/proyectos") ||
		pathname.startsWith("/es/blog") ||
		pathname.startsWith("/servicios") ||
		pathname.startsWith("/es/servicios")
	);
}
---

<html lang={lang}>
	<head>
		<!-- Google Tag Manager -->
		<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
		new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
		j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
		'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
		})(window,document,'script','dataLayer','GTM-N4889HZM');</script>
		<!-- End Google Tag Manager -->
		<BaseHead />
		{
			useLegacySeo ? (
				<AstroSeo {...legacySeo} />
			) : (
				<RankMathSeo post={wpPost} siteUrl={siteUrl} fallbackTitle={fallbackTitle} fallbackDescription={fallbackDescription} />
			)
		}
		<!-- Hreflang multiidioma -->
		{hreflangLinks.map(({ lang: l, url }) => <link rel="alternate" hreflang={l} href={url} />)}
		<link rel="alternate" hreflang="x-default" href={siteUrl} />
	</head>
	<body class="bg-slate-50">
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N4889HZM"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		<BackgroundTexture />
		<Navigation />
		{cursorFollowerActive() && <BlobCursorFollower color={cursorColor} />}
		<slot />
		<Footer />
		<LegalModals />
		<CookieBanner />
		<WhatsAppFloat phone={waPhone} defaultText={waDefaultText} hoverText={waHoverText} message={waMessage} />
	</body>
</html>
